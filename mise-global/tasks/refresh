#!/usr/bin/env bash
#MISE description="Pull the latest default branch into this repo, then sync dependencies if that changed any"
#USAGE flag "--sync" help="Sync even when no dependency files changed"
#
# Global mise task: `mise run refresh` from anywhere inside a git checkout.
#
# Picks the branch action from git state: on the default branch it
# fast-forwards; on a branch whose remote is gone it lands you back on the
# default branch and deletes the branch; on a live branch it merges the default
# branch in. The delete is guarded on content rather than merge ancestry — the
# branch goes only if merging it would add nothing — so squash-merged branches
# are recognised and unmerged ones survive even when the remote dropped them.
#
# Then, in a pnpm repo, it syncs — but only when the incoming commits touched
# dependency files (pass --sync to force it). Syncing means `pnpm run sync` if
# the root package.json defines a `sync` script, so a repo can extend it (e.g.
# codegen, migrations), and `pnpm install` otherwise. Non-pnpm repos skip it.
#
# Uncommitted work is fine: pull and merge both --autostash. The exception is
# a branch due for deletion, which is refused while dirty — that work has
# nowhere to land once the branch is gone.

set -euo pipefail

REMOTE=origin

log() { printf '%s\n' "$@" >&2; }
fail() {
  printf '\n✗ %s\n' "$*" >&2
  exit 1
}
# Runs a labelled step, exiting the whole refresh if it fails.
step() {
  local label=$1
  shift
  log "" "▸ $label"
  "$@" || fail "$label failed"
}
# Runs a labelled step, returning its status so callers can degrade.
try_step() {
  local label=$1
  shift
  log "" "▸ $label"
  "$@"
}

force_sync=false
# mise parses the #USAGE flags itself and exposes them as usage_* variables;
# the loop covers running the file directly.
[[ ${usage_sync:-} == true ]] && force_sync=true
for arg in "$@"; do
  case $arg in
    --sync) force_sync=true ;;
    -h | --help)
      log "Usage: mise run refresh [--sync]" "" \
        "  --sync  Sync even when no dependency files changed."
      exit 0
      ;;
    *) fail "Unknown option: $arg" ;;
  esac
done

# Global tasks do not run from the caller's directory, so go back there first.
cd "${MISE_ORIGINAL_CWD:-$PWD}"
root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "Not a git checkout."
cd "$root"

branch=$(git symbolic-ref --quiet --short HEAD) ||
  fail "Detached HEAD. Check out a branch first."

git remote get-url "$REMOTE" >/dev/null 2>&1 || fail "No '$REMOTE' remote."

# The remote's HEAD names the default branch; fall back to main/master when it
# was never recorded (e.g. a repo that was `git init`ed then had a remote added).
if default=$(git symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD"); then
  MAIN=${default#"$REMOTE"/}
elif git show-ref --quiet "refs/remotes/$REMOTE/main"; then
  MAIN=main
elif git show-ref --quiet "refs/remotes/$REMOTE/master"; then
  MAIN=master
else
  fail "Cannot tell the default branch. Run: git remote set-head $REMOTE --auto"
fi

# Tracked changes only: untracked files do not block a checkout or merge, and
# git refuses on its own in the rare case an incoming change collides with one.
dirty=false
[[ -n $(git status --porcelain --untracked-files=no) ]] && dirty=true

log "Refreshing $(basename "$root") on $branch"

before=$(git rev-parse HEAD)

if [[ $branch == "$MAIN" ]]; then
  # --ff-only so a diverged local main fails loudly instead of opening a merge.
  step pull git pull --ff-only --autostash
else
  # One round trip: updates origin/main and prunes refs for branches deleted
  # on the remote, which is what marks a branch [gone].
  step fetch git fetch --prune "$REMOTE"

  # A branch with no upstream reports empty, not [gone], so it merges like any
  # live branch and never reaches the delete below.
  gone=false
  [[ $(git for-each-ref --format='%(upstream:track)' "refs/heads/$branch") == "[gone]" ]] &&
    gone=true

  # Fetching from '.' moves local main to the origin/main just fetched, with no
  # second network trip. No + on the refspec, so a diverged main errors instead
  # of being moved. It also refuses if main is checked out in another worktree.
  main_current=true
  try_step "update $MAIN" git fetch . "$REMOTE/$MAIN:$MAIN" || main_current=false

  if $gone; then
    $dirty && fail "Uncommitted changes, and the remote for $branch is gone.
  Commit or stash them first — this branch is a delete candidate, so they have nowhere to land."
    $main_current || fail "Local $MAIN could not be updated from $REMOTE/$MAIN.
  Resolve it before deleting $branch — landing on a stale $MAIN is worse than keeping the branch."

    step "checkout $MAIN" git checkout "$MAIN"

    # -d refuses after a squash merge, since main never gets the branch's own
    # commits. So ask a content question instead: merge the two in memory and
    # compare with main's tree. Identical means the branch adds nothing main
    # lacks. A conflict exits non-zero, which keeps the branch.
    if merged=$(git merge-tree --write-tree "$MAIN" "$branch" 2>/dev/null) &&
      [[ $merged == "$(git rev-parse "$MAIN^{tree}")" ]]; then
      step "delete $branch" git branch -D "$branch"
    else
      log "" "! kept $branch — it has work that $MAIN does not" \
        "  Delete it anyway with: git branch -D $branch"
    fi
  else
    # The merge only needs the commits, so a stale local main degrades to
    # merging origin/main rather than stopping the refresh.
    source=$MAIN
    if ! $main_current; then
      source=$REMOTE/$MAIN
      log "" "! local $MAIN could not be updated — merging $source instead"
    fi
    # On a conflict, uncommitted changes sit in the merge's autostash, which
    # git reapplies whether you finish the merge or abort it.
    if ! try_step "merge $source" git merge --autostash "$source"; then
      msg="merge $source failed. Resolve the conflicts and commit, or run git merge --abort."
      $dirty && msg+="
  Your uncommitted changes are held in the autostash and come back either way."
      fail "$msg"
    fi
  fi
fi

after=$(git rev-parse HEAD)

if [[ ! -f pnpm-lock.yaml && ! -f pnpm-workspace.yaml ]]; then
  if [[ $before == "$after" ]]; then log "" "▸ already up to date"; else log "" "▸ done"; fi
  exit 0
fi

needs_sync=false
if [[ $before != "$after" ]] &&
  git diff --name-only "$before" "$after" |
  grep -qE '(^|/)package\.json$|^pnpm-lock\.yaml$|^pnpm-workspace\.yaml$|^\.npmrc$|^\.pnpmfile\.cjs$'; then
  needs_sync=true
fi

if ! $force_sync && ! $needs_sync; then
  if [[ $before == "$after" ]]; then
    log "" "▸ already up to date"
  else
    log "" "▸ skipped sync — no dependency changes" \
      "  Run mise run refresh --sync to force it."
  fi
  exit 0
fi

if node -e 'process.exit(require("./package.json").scripts?.sync ? 0 : 1)' 2>/dev/null; then
  step sync pnpm run sync
else
  step install pnpm install
fi
